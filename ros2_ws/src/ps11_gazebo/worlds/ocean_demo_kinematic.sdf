<?xml version="1.0" ?>
<!-- Ocean demo world in kinematic mode (§8.1, T1.2).
     Gravity: 0 0 0 (kinematic velocity control).
     Seabed: plane at z = -15 m with placeholder sand material (replaced in T1.4).
     Lighting & Scene: dark teal ambient/background with dim overhead sunlight.
-->
<sdf version="1.8">
  <world name="ocean_demo_kinematic">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World gravity is 0 0 0 in kinematic mode -->
    <gravity>0 0 0</gravity>

    <!-- Gazebo Harmonic Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Scene lighting: dark teal background and ambient -->
    <scene>
      <ambient>0.05 0.12 0.15 1.0</ambient>
      <background>0.02 0.08 0.12 1.0</background>
      <grid>false</grid>
    </scene>

    <!-- Dim directional light from above surface -->
    <light type="directional" name="sun_underwater">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.5 0.7 0.8 1.0</diffuse>
      <specular>0.2 0.3 0.4 1.0</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
      </attenuation>
      <direction>-0.1 0.1 -0.98</direction>
    </light>

    <!-- Seabed: generated decal tiles at z = -15 m (T1.4, deterministic via tools/make_seabed.py).
         Models are generated artifacts (gitignored); regenerate before running the sim. -->
    <!-- SEABED_TILES_START -->
    <include><name>seabed_tile_0_0</name><uri>model://seabed_tile_0_0</uri><pose>-20.0 -10.0 -15.0 0 0 0</pose></include>
    <include><name>seabed_tile_1_0</name><uri>model://seabed_tile_1_0</uri><pose>0.0 -10.0 -15.0 0 0 0</pose></include>
    <include><name>seabed_tile_2_0</name><uri>model://seabed_tile_2_0</uri><pose>20.0 -10.0 -15.0 0 0 0</pose></include>
    <include><name>seabed_tile_0_1</name><uri>model://seabed_tile_0_1</uri><pose>-20.0 10.0 -15.0 0 0 0</pose></include>
    <include><name>seabed_tile_1_1</name><uri>model://seabed_tile_1_1</uri><pose>0.0 10.0 -15.0 0 0 0</pose></include>
    <include><name>seabed_tile_2_1</name><uri>model://seabed_tile_2_1</uri><pose>20.0 10.0 -15.0 0 0 0</pose></include>
    <!-- SEABED_TILES_END -->
  </world>
</sdf>
