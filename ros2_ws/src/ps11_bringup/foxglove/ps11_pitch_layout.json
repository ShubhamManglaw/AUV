{
  "configById": {
    "Image!vehicle_camera": {
      "title": "Camera — annotated detections",
      "cameraTopic": "/vehicle/perception/image_annotated/compressed",
      "imageTopic": "/vehicle/perception/image_annotated/compressed",
      "transformMarkers": false,
      "synchronize": false
    },
    "3D!vehicle_onboard_view": {
      "title": "VEHICLE — onboard (simulation)",
      "cameraState": {
        "perspective": true,
        "distance": 10.0,
        "phi": 60.0,
        "thetaOffset": 0.0,
        "targetOffset": [0, 0, 0],
        "target": [0, 0, -12.5],
        "fovy": 45.0
      },
      "followMode": "follow-pose",
      "followTf": "base_link",
      "layers": {
        "grid": {
          "layerId": "grid",
          "visible": true,
          "size": 50,
          "divisions": 50,
          "position": [0, 0, -15.0]
        }
      },
      "scene": {
        "transforms": {
          "showBounds": false
        }
      },
      "transforms": {
        "frame:map": { "visible": true },
        "frame:base_link": { "visible": true }
      },
      "topics": {
        "/vehicle/markers": { "visible": true },
        "/eval/gt_markers": { "visible": false }
      }
    },
    "3D!surface_topdown_view": {
      "title": "SURFACE — received over emulated 64 bps acoustic link",
      "cameraState": {
        "perspective": false,
        "distance": 45.0,
        "phi": 0.0,
        "thetaOffset": 0.0,
        "targetOffset": [0, 0, 0],
        "target": [25.0, 0.0, -15.0],
        "fovy": 45.0
      },
      "followMode": "fixed",
      "layers": {
        "grid": {
          "layerId": "grid",
          "visible": true,
          "size": 60,
          "divisions": 6,
          "position": [25.0, 0.0, -15.0],
          "color": "#404040"
        }
      },
      "topics": {
        "/surface/markers": { "visible": true },
        "/surface/vehicle_track": { "visible": true }
      }
    },
    "Table!surface_contacts": {
      "title": "Decoded Surface Contacts",
      "topicPath": "/surface/contacts.contacts"
    },
    "Plot!semantic_bits_plot": {
      "title": "Semantic bits sent (cumulative)",
      "paths": [
        {
          "value": "/eval/counters.semantic_bits_sent",
          "enabled": true,
          "color": "#4ECDC4",
          "timestampMethod": "receiveTime"
        }
      ],
      "showLegend": false,
      "minYValue": 0
    },
    "Plot!video_bits_plot": {
      "title": "Video-equivalent bits (cumulative)",
      "paths": [
        {
          "value": "/eval/counters.jpeg_equiv_bits",
          "enabled": true,
          "color": "#E4572E",
          "timestampMethod": "receiveTime"
        }
      ],
      "showLegend": false,
      "minYValue": 0
    },
    "RawMessages!semantic_bits": {
      "title": "Bits sent (semantic)",
      "topicPath": "/eval/counters.semantic_bits_sent"
    },
    "RawMessages!video_bits": {
      "title": "Video-equivalent bits (JPEG)",
      "topicPath": "/eval/counters.jpeg_equiv_bits"
    },
    "RawMessages!ratio_jpeg": {
      "title": "Ratio vs JPEG",
      "topicPath": "/eval/counters.ratio_vs_jpeg"
    },
    "RawMessages!video_airtime": {
      "title": "Video airtime on 64 bps link (s)",
      "topicPath": "/eval/counters.jpeg_airtime_at_link_s"
    },
    "RawMessages!correct_contacts": {
      "title": "Contacts at surface (correct)",
      "topicPath": "/eval/counters.correct_contacts"
    },
    "RawMessages!false_contacts": {
      "title": "Contacts at surface (false)",
      "topicPath": "/eval/counters.false_contacts"
    },
    "RawMessages!link_stats": {
      "title": "Acoustic Link Stats (/link/stats)",
      "topicPath": "/link/stats"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "column",
    "first": {
      "direction": "row",
      "first": {
        "title": "VEHICLE — onboard (simulation)",
        "direction": "column",
        "first": "Image!vehicle_camera",
        "second": "3D!vehicle_onboard_view",
        "splitPercentage": 50
      },
      "second": {
        "title": "SURFACE — received over emulated 64 bps acoustic link",
        "direction": "column",
        "first": "3D!surface_topdown_view",
        "second": "Table!surface_contacts",
        "splitPercentage": 60
      },
      "splitPercentage": 50
    },
    "second": {
      "title": "Bandwidth & Telemetry Evaluation",
      "direction": "row",
      "first": {
        "direction": "column",
        "first": "Plot!semantic_bits_plot",
        "second": "Plot!video_bits_plot",
        "splitPercentage": 50
      },
      "second": {
        "direction": "row",
        "first": {
          "direction": "column",
          "first": "RawMessages!semantic_bits",
          "second": {
            "direction": "column",
            "first": "RawMessages!video_bits",
            "second": "RawMessages!ratio_jpeg",
            "splitPercentage": 50
          },
          "splitPercentage": 33
        },
        "second": {
          "direction": "column",
          "first": "RawMessages!video_airtime",
          "second": {
            "direction": "column",
            "first": {
              "direction": "row",
              "first": "RawMessages!correct_contacts",
              "second": "RawMessages!false_contacts",
              "splitPercentage": 50
            },
            "second": "RawMessages!link_stats",
            "splitPercentage": 50
          },
          "splitPercentage": 33
        },
        "splitPercentage": 50
      },
      "splitPercentage": 40
    },
    "splitPercentage": 68
  }
}
